<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Patient Migration" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag "bootstrap.min", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-dark bg-primary mb-4">
      <div class="container">
        <%= link_to "Patient Migration", root_path, class: "navbar-brand fw-semibold" %>

        <div class="d-flex gap-3">
          <%= link_to "Upload CSV", new_import_path, class: "nav-link text-white" %>
          <%= link_to "Migration history", imports_path, class: "nav-link text-white" %>
          <%= link_to "Patients", patients_path, class: "nav-link text-white" %>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <% if alert %>
        <div class="alert alert-danger"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
