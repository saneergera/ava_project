<% content_for :title, "Migration history" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Migration history</h1>
  <%= link_to "Upload CSV", new_import_path, class: "btn btn-primary" %>
</div>

<% if @imports.empty? %>
  <div class="alert alert-info">No files have been uploaded yet.</div>
<% else %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>File</th>
            <th>Uploaded (UTC)</th>
            <th>Status</th>
            <th class="text-end">Created</th>
            <th class="text-end">Updated</th>
            <th class="text-end">Unchanged</th>
            <th class="text-end">Failed</th>
          </tr>
        </thead>
        <tbody>
          <% @imports.each do |import| %>
            <tr>
              <td><%= link_to import.filename, import_path(import) %></td>
              <td class="text-nowrap"><%= import.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= status_badge(import) %></td>
              <td class="text-end"><%= import.created_count %></td>
              <td class="text-end"><%= import.updated_count %></td>
              <td class="text-end"><%= import.unchanged_count %></td>
              <td class="text-end"><%= import.failed_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
